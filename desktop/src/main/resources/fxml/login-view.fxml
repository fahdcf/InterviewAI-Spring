<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.interviewai.desktop.feature.auth.LoginController"
           prefWidth="720" prefHeight="490" styleClass="dark-root" stylesheets="@../css/connection.css">
    <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>
    <VBox fx:id="form" alignment="CENTER" spacing="14" maxWidth="420" styleClass="auth-dark">
        <Label text="InterviewAI" styleClass="title-dark"/>
        <Label text="Sign in" styleClass="subtitle-dark"/>
        <TextField fx:id="usernameField" promptText="Email or username" styleClass="input-dark"/>
        <PasswordField fx:id="passwordField" promptText="Password" styleClass="input-dark"/>
        <Button fx:id="loginButton" text="Sign in" onAction="#onLogin" defaultButton="true"
                maxWidth="Infinity" styleClass="btn-primary-blue"/>
        <Label fx:id="statusLabel" wrapText="true" styleClass="subtitle-dark"/>
        <HBox alignment="CENTER" spacing="12">
            <Button fx:id="registerButton" text="Create account" onAction="#onOpenCreateAccount" styleClass="button-link"/>
            <Button text="Forgot password?" onAction="#onForgotPassword" styleClass="button-link"/>
        </HBox>
        <Button text="Check backend connection" onAction="#onCheckConnection" styleClass="button-link"/>
    </VBox>
</StackPane>
