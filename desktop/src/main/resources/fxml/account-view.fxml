<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.interviewai.desktop.feature.auth.AccountController"
           prefWidth="720" prefHeight="490" styleClass="dark-root" stylesheets="@../css/connection.css">
    <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>
    <VBox alignment="CENTER" spacing="14" maxWidth="420" styleClass="auth-dark">
        <Label fx:id="accountLabel" wrapText="true" styleClass="title-dark"/>
        <Label fx:id="statusLabel" wrapText="true" styleClass="subtitle-dark"/>
        <Button fx:id="logoutButton" text="Sign out" onAction="#onLogout" styleClass="btn-primary-blue"/>
    </VBox>
</StackPane>
