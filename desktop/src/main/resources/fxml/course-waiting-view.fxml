<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.interviewai.desktop.feature.onboarding.CourseWaitingController"
           styleClass="dark-root" stylesheets="@../css/connection.css">
    <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>
    <VBox alignment="CENTER" spacing="18" maxWidth="480">
        <Label text="Course generation" styleClass="title-dark"/>
        <ProgressBar fx:id="progress" maxWidth="Infinity"/>
        <Label fx:id="statusLabel" text="Checking your course generation…" wrapText="true" styleClass="subtitle-dark"/>
        <Button fx:id="retryButton" text="Retry" styleClass="btn-primary-blue" onAction="#retry"/>
        <Button text="Back to dashboard" styleClass="button-link" onAction="#back"/>
    </VBox>
</StackPane>
