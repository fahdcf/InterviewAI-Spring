<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.interviewai.desktop.feature.progress.ProgressController"
            stylesheets="@../css/connection.css">
    <VBox fx:id="content" spacing="10" styleClass="dark-root">
        <padding><Insets top="20" right="28" bottom="20" left="28"/></padding>
        <FlowPane hgap="10">
            <Button text="Back to dashboard" onAction="#back" styleClass="button-link"/>
            <Button text="Refresh" onAction="#refresh" styleClass="button-link"/>
        </FlowPane>
        <Label text="Your progress" styleClass="title-dark"/>
        <Label fx:id="summaryLabel" styleClass="subtitle-dark" wrapText="true"/>
        <Label fx:id="statusLabel" styleClass="subtitle-dark" wrapText="true"/>
        <BarChart fx:id="xpChart" prefHeight="210" legendVisible="false" animated="false"
                  title="XP earned in the last 7 days" styleClass="progress-chart">
            <xAxis><CategoryAxis tickLabelFill="#cbd5e1"/></xAxis>
            <yAxis><NumberAxis tickLabelFill="#cbd5e1"/></yAxis>
        </BarChart>
        <Label text="Goals" styleClass="title-dark"/>
        <ListView fx:id="goals" prefHeight="140"/>
        <FlowPane hgap="8" vgap="8">
            <TextField fx:id="goalName" promptText="Goal name" styleClass="input-dark"/>
            <ComboBox fx:id="goalType"/>
            <TextField fx:id="goalTarget" promptText="Target" prefWidth="95" styleClass="input-dark"/>
            <Button text="Add goal" onAction="#addGoal" styleClass="btn-primary-blue"/>
            <Button text="Update selected" onAction="#updateGoal" styleClass="button-link"/>
            <Button text="Remove selected" onAction="#removeGoal" styleClass="button-link"/>
        </FlowPane>
        <Label text="Quests" styleClass="title-dark"/>
        <Label text="Daily · Answer questions" styleClass="subtitle-dark"/>
        <Label fx:id="dailyLabel" styleClass="subtitle-dark"/>
        <Button fx:id="dailyClaim" text="Claim daily reward" onAction="#claimDaily" disable="true"/>
        <Label text="Monthly · Complete chapters" styleClass="subtitle-dark"/>
        <Label fx:id="monthlyLabel" styleClass="subtitle-dark"/>
        <Button fx:id="monthlyClaim" text="Claim monthly reward" onAction="#claimMonthly" disable="true"/>
        <Label text="Leaderboard" styleClass="title-dark"/>
        <ListView fx:id="rankings" prefHeight="150"/>
    </VBox>
</ScrollPane>
