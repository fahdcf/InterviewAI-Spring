<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.interviewai.desktop.feature.auth.RegisterController"
           prefWidth="720" prefHeight="490" styleClass="dark-root" stylesheets="@../css/connection.css">
    <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>
    <VBox fx:id="form" alignment="CENTER" spacing="14" maxWidth="420" styleClass="auth-dark">
        <Label text="Create account" styleClass="title-dark"/>
        <TextField fx:id="usernameField" promptText="Username" styleClass="input-dark"/>
        <TextField fx:id="emailField" promptText="Email (optional)" styleClass="input-dark"/>
        <PasswordField fx:id="passwordField" promptText="Password" styleClass="input-dark"/>
        <Button fx:id="createButton" text="Create account" onAction="#onCreate" defaultButton="true"
                maxWidth="Infinity" styleClass="btn-primary-blue"/>
        <Label fx:id="statusLabel" wrapText="true" styleClass="subtitle-dark"/>
        <Button text="Back to sign-in" onAction="#onBack" styleClass="button-link"/>
    </VBox>
</StackPane>
